# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║          OCP AI Monitoring Agent — Environment Configuration               ║
# ║  Copy this file to .env and fill in your actual values.                    ║
# ║  NEVER commit .env to version control.                                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=llama-3.3-70b-versatile
# Temperature=0 for deterministic JSON outputs in analysis chains
LLM_TEMPERATURE=0
# Max tokens for analysis response (failures JSON can be large)
LLM_MAX_TOKENS=4096

# ── OpenShift Cluster ─────────────────────────────────────────────────────────
# For in-cluster deployment, leave these blank — agent auto-detects ServiceAccount
# For local/external testing, provide path to kubeconfig
KUBECONFIG_PATH=
# Override the context name if needed (leave blank for current-context)
OCP_CONTEXT=
# Cluster display name shown in reports and dashboard
CLUSTER_NAME=SB-PROD-OCP

# ── PostgreSQL Database ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres-svc
POSTGRES_PORT=5432
POSTGRES_DB=ocp_monitor
POSTGRES_USER=ocp_agent
POSTGRES_PASSWORD=changeme_strong_password_here
# Full DSN is constructed from above; or override directly:
# DATABASE_URL=postgresql+psycopg2://ocp_agent:password@postgres-svc:5432/ocp_monitor

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Choose one: smtp or sendgrid
EMAIL_BACKEND=smtp

## SMTP settings (used when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-app-specific-password
SMTP_USE_TLS=true

## SendGrid settings (used when EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## Common email settings
EMAIL_FROM=ocp-monitor@company.com
# JSON array of recipient addresses
EMAIL_TO=["ops-team@company.com", "platform-admin@company.com"]
# Send email even when cluster is healthy (set false to only alert on failures)
EMAIL_ON_HEALTHY=true

# ── Scheduler ─────────────────────────────────────────────────────────────────
INTERVAL_MINUTES=15
TIMEZONE=Asia/Kolkata

# ── Health Check Thresholds ───────────────────────────────────────────────────
# CPU/Memory % threshold — alert if any node exceeds this
NODE_CPU_THRESHOLD=80
NODE_MEMORY_THRESHOLD=80
# TLS cert expiry warning window (days)
CERT_EXPIRY_WARNING_DAYS=30

# ── CP4I Specific ─────────────────────────────────────────────────────────────
# Namespaces to monitor for failing pods (comma-separated)
MONITORED_NAMESPACES=openshift-etcd,openshift-kube-apiserver,openshift-kube-controller-manager,openshift-kube-scheduler,openshift-ingress,openshift-storage,cp4i,ibm-common-services,cms

# CP4I API endpoints to health-check (comma-separated URLs)
CP4I_HEALTH_ENDPOINTS=https://sb-pr-apic-gw-gateway-cp4i.apps.ocp-pr.mz.sbicdirectory.com/webapi-init-check,https://sb-pr-apic-gw-gateway-manager-cp4i.apps.ocp-pr.mz.sbicdirectory.com/health

# ── LlamaIndex RAG ────────────────────────────────────────────────────────────
# Embeddings model for indexing historical incidents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Top-K similar incidents to retrieve
RAG_TOP_K=3

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# How many past runs to show on dashboard
DASHBOARD_HISTORY_LIMIT=20

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Format: json (for log aggregators like Splunk/ELK) or console (human-readable)
LOG_FORMAT=json
